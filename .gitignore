cat > .gitignore << 'EOF'
# Binarios
testa_monitora_logs
testa_monitora_logs_cov
*.o
*.obj
*.exe

# Cobertura
*.gcno
*.gcda
*.gcov

# Doxygen
doc/
html/
latex/

# Editor
*.swp
*.swo
.vscode/
.idea/

# Arquivos de teste temporarios
test_tmp/
*.tmp
EOF
# Arquivos temporários de teste
teste_*.txt
lista_*.txt
log_existente*.txt
total_log_existente*.txt

# Executáveis e relatórios do compilador
testa_monitora_logs
*.o
*.gcov
*.gcda
*.gcno
